# Local mode is the default and uses backend/boxing_coach.db.
BOXING_COACH_DATA_MODE=local
# Optional isolated local database, for tests or development. Leave empty for the default.
BOXING_COACH_DB_PATH=
# Explicit browser origins for hosted or LAN access. Never use wildcards.
BOXING_COACH_ALLOWED_ORIGINS=
# Optional persistent local signing secret; generate a strong random value, never commit it.
BOXING_COACH_TOKEN_SECRET=

# Set all three values to use the central Supabase data plane.
BOXING_COACH_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
BOXING_COACH_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Set the same domain in the gateway and admin-create-user Edge Function.
BOXING_COACH_AUTH_EMAIL_DOMAIN=accounts.example.invalid

# Hosted central web/API runtime. Put HTTPS termination in front of cloud_server.py.
BOXING_COACH_HOST=127.0.0.1
BOXING_COACH_PORT=8080

# Windows hosted UI settings. Production hosted URLs must use HTTPS.
BOXING_COACH_UI_MODE=hosted
BOXING_COACH_HOSTED_APP_URL=https://app.example.com/
BOXING_COACH_ALLOW_BUNDLED_FALLBACK=true

# Desktop development overrides. Production packages discover worker/BoxingCoach.Worker.exe automatically.
BOXING_COACH_PROJECT_ROOT=C:\path\to\box
BOXING_COACH_PYTHON=C:\path\to\python.exe
