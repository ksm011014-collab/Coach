<?xml version="1.0" encoding="utf-8"?>
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2021"
  Uri="@@APPINSTALLER_URI@@"
  Version="@@VERSION@@">
  <MainPackage
    Name="@@PACKAGE_ID@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@"
    ProcessorArchitecture="x64"
    Uri="@@PACKAGE_URI@@" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0" ShowPrompt="true" UpdateBlocksActivation="@@BLOCKS_ACTIVATION@@" />
    <AutomaticBackgroundTask />
  </UpdateSettings>
</AppInstaller>
