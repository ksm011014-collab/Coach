<Window x:Class="BoxingCoach.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="APEX Boxing AI Coach"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#050A10">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <wv2:WebView2 x:Name="AppWebView" Grid.Row="0" />

    <Border Grid.Row="1" Background="#09131D" Padding="10,0">
      <TextBlock x:Name="StatusText"
                 Foreground="#9AB0C2"
                 VerticalAlignment="Center"
                 FontSize="12"
                 Text="BoxingCoach를 시작하는 중입니다…" />
    </Border>
  </Grid>
</Window>
